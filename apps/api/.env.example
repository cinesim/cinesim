# Copy this file to .env.local, or run `vp run api:setup` to generate it.
# Never commit .env.local. Every deployed environment must use different secrets.
CINESIM_ENV=development
CINESIM_API_HOST=127.0.0.1
CINESIM_API_PORT=8787
CINESIM_DESKTOP_SCHEME=build.cinesim.dev
BETTER_AUTH_URL=http://127.0.0.1:8787
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
DATABASE_URL=postgresql://cinesim:cinesim-local@127.0.0.1:54329/cinesim
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM=Cinesim <hello@cinesim.local>

# Server-side Deepgram credential and hard application budgets for editable Nova-3 transcripts.
DEEPGRAM_API_KEY=
CINESIM_TRANSCRIPTION_USER_CONCURRENCY=2
CINESIM_TRANSCRIPTION_SERVICE_CONCURRENCY=8
CINESIM_TRANSCRIPTION_REQUESTS_PER_MINUTE=12
CINESIM_TRANSCRIPTION_NETWORK_REQUESTS_PER_MINUTE=30
CINESIM_TRANSCRIPTION_USER_MONTHLY_SECONDS=7200
CINESIM_TRANSCRIPTION_SERVICE_MONTHLY_SECONDS=360000
CINESIM_TRANSCRIPTION_MAX_REQUEST_SECONDS=600
CINESIM_TRANSCRIPTION_PROVIDER_TIMEOUT_MS=75000

# Optional server-side OpenRouter credential reserved for general text transcription.
OPENROUTER_API_KEY=

# Create a Google OAuth "Web application" and register this exact redirect URI:
# http://127.0.0.1:8787/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Cloudflare R2 originals storage. Cloud features stay disabled unless all four are set.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CINESIM_CLOUD_INCLUDED_BYTES=10737418240
CINESIM_CLOUD_ADDON_OPTIONS_BYTES=0,53687091200,214748364800
