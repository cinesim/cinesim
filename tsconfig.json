{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": ["node", "@webgpu/types"],
    "paths": {
      "@cinesim/core": ["./packages/core/src/index.ts"],
      "@cinesim/engine": ["./packages/engine/src/index.ts"],
      "@cinesim/logging": ["./packages/logging/src/index.ts"],
      "@cinesim/protocol": ["./packages/protocol/src/index.ts"],
      "@cinesim/ui": ["./packages/ui/src/index.ts"]
    }
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "packages/**/*.tsx",
    "tools/**/*.ts",
    "vite.config.ts"
  ]
}
